+class InteractivePreview(Image):
+    """Video canvas that can directly move/scale/rotate the selected layer.
+
+    One finger drags the selected timeline layer (or the static sticker).
+    Two fingers pinch to scale and twist to rotate. All edits feed the same
+    live-preview/keyframe state used by export, so the canvas is not a fake UI.
+    """
+    def __init__(self, owner, **kwargs):
+        super().__init__(**kwargs)
+        self.owner = owner
+        self._touches = {}
+        self._gesture_start = None
+
+    def _image_rect(self):
+        try:
+            iw, ih = self.norm_image_size
+        except Exception:
+            iw, ih = self.width, self.height
+        iw = max(1.0, float(iw)); ih = max(1.0, float(ih))
+        return self.center_x - iw/2.0, self.center_y - ih/2.0, iw, ih
+
+    def _norm(self, x, y):
+        left, bottom, width, height = self._image_rect()
+        nx = max(0.0, min(1.0, (x-left)/width))
+        ny = max(0.0, min(1.0, 1.0 - (y-bottom)/height))
+        return nx, ny
+
+    def on_touch_down(self, touch):
+        if not self.collide_point(*touch.pos):
+            return super().on_touch_down(touch)
+        if not self.owner._direct_canvas_target_available():
+            return super().on_touch_down(touch)
+        touch.grab(self)
+        self._touches[touch.uid] = touch.pos
+        if len(self._touches) == 1:
+            nx, ny = self._norm(*touch.pos)
+            self.owner._direct_canvas_edit(x=nx, y=ny, commit=False)
+        elif len(self._touches) == 2:
+            pts=list(self._touches.values())
+            dx=pts[1][0]-pts[0][0]; dy=pts[1][1]-pts[0][1]
+            dist=max(1.0, math.hypot(dx,dy)); ang=math.degrees(math.atan2(dy,dx))
+            scale, rot=self.owner._direct_canvas_scale_rotation()
+            self._gesture_start=(dist,ang,scale,rot)
+        return True
+
+    def on_touch_move(self, touch):
+        if touch.grab_current is not self:
+            return super().on_touch_move(touch)
+        self._touches[touch.uid] = touch.pos
+        if len(self._touches) == 1:
+            nx, ny = self._norm(*touch.pos)
+            self.owner._direct_canvas_edit(x=nx, y=ny, commit=False)
+        elif len(self._touches) >= 2:
+            pts=list(self._touches.values())[:2]
+            dx=pts[1][0]-pts[0][0]; dy=pts[1][1]-pts[0][1]
+            dist=max(1.0, math.hypot(dx,dy)); ang=math.degrees(math.atan2(dy,dx))
+            if self._gesture_start is None:
+                scale,rot=self.owner._direct_canvas_scale_rotation()
+                self._gesture_start=(dist,ang,scale,rot)
+            d0,a0,s0,r0=self._gesture_start
+            mx=(pts[0][0]+pts[1][0])*0.5; my=(pts[0][1]+pts[1][1])*0.5
+            nx,ny=self._norm(mx,my)
+            self.owner._direct_canvas_edit(x=nx, y=ny, scale=max(0.01,min(3.0,s0*(dist/d0))), rotation=r0+(ang-a0), commit=False)
+        return True
+
+    def on_touch_up(self, touch):
+        if touch.grab_current is not self:
+            return super().on_touch_up(touch)
+        self._touches.pop(touch.uid, None)
+        touch.ungrab(self)
+        if len(self._touches) < 2:
+            self._gesture_start = None
+        self.owner._direct_canvas_commit()
+        return True
+
