+    # ---------- direct canvas editing ----------
+    def _direct_canvas_target_available(self) -> bool:
+        try:
+            return self._selected_track() is not None or bool(self.sticker_path)
+        except Exception:
+            return bool(self.sticker_path)
+
+    def _direct_canvas_scale_rotation(self):
+        track = self._selected_track() if hasattr(self, "track_spinner") else None
+        if track is not None:
+            return max(0.01, self._float(self.track_scale, 0.25)), self._float(self.track_rotation, 0.0)
+        return max(0.01, self._float(self.sticker_scale, 0.25)), 0.0
+
+    def _direct_canvas_edit(self, x=None, y=None, scale=None, rotation=None, commit=False):
+        track = self._selected_track() if hasattr(self, "track_spinner") else None
+        if track is not None:
+            if x is not None: self.track_x.text = f"{max(0.0,min(1.0,float(x))):.4f}"
+            if y is not None: self.track_y.text = f"{max(0.0,min(1.0,float(y))):.4f}"
+            if scale is not None: self.track_scale.text = f"{max(0.01,min(3.0,float(scale))):.4f}"
+            if rotation is not None: self.track_rotation.text = f"{float(rotation):.2f}"
+            # During a drag we mutate the key at the current playhead directly so
+            # the live compositor follows the finger. On release we refresh labels.
+            seconds = float(self._live_seconds)
+            self.timeline_time.text = f"{seconds:.6f}"
+            key = self._default_track_key(seconds)
+            replaced = False
+            for i, existing in enumerate(track.keyframes):
+                if abs(existing.time-key.time) <= 0.0005:
+                    track.keyframes[i] = key; replaced=True; break
+            if not replaced:
+                track.keyframes.append(key)
+            track.keyframes.sort(key=lambda item:item.time)
+            self._schedule_live_refresh(0.0)
+            if commit:
+                self._refresh_tracks(track.track_id)
+            return
+        if self.sticker_path:
+            if x is not None: self.sticker_x.text = f"{max(0.0,min(1.0,float(x))):.4f}"
+            if y is not None: self.sticker_y.text = f"{max(0.0,min(1.0,float(y))):.4f}"
+            if scale is not None: self.sticker_scale.text = f"{max(0.01,min(3.0,float(scale))):.4f}"
+            self._schedule_live_refresh(0.0)
+
+    def _direct_canvas_commit(self):
+        self._direct_canvas_edit(commit=True)
